# --- PayPal (required) ---
# developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook id from the same app's Webhooks section (required for /api/paypal/webhook)
PAYPAL_WEBHOOK_ID=
# Public URL of this API; PayPal redirects the buyer to $PUBLIC_BASE_URL/api/paypal/return
PUBLIC_BASE_URL=http://localhost:8000
CURRENCY=USD

# --- LLM (required): anthropic | openai ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# LLM_MODEL=                                   # defaults: claude-sonnet-5-5 / gpt-4o-mini

# --- Optional ---
TRUSTPAY_DB=trustpay.db
# If set, every /api/assessments and /api/analyze call needs header X-API-Key
TRUSTPAY_API_KEY=
# Comma-separated origins allowed by CORS (empty = no CORS)
ALLOWED_ORIGINS=
# Where PayPal return/cancel send the buyer's browser (empty = return JSON)
FRONTEND_URL=
# Max /api/analyze* calls per client IP per minute (0 = off)
RATE_LIMIT_PER_MIN=20

# Sponsor product comparison (server-side only)
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com/v1

# Default PayPal checkout language: en-US, ar-AE, fr-FR
PAYPAL_LOCALE=en-US
